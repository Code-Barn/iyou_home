# Logs
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# Node / Web Build
node_modules
dist
dist-ssr
*.local

# Rust Build
src-tauri/target/
target/

# Editor directories and files
.vscode/*
!.vscode/extensions.json
.idea
.DS_Store
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# Vault / keystore / seed artifacts & backups
*.vault
*.key
*.p12
*.jks
*.iyoubackup
*.corrupt_*.bak
test_seed*.json

# Runtime TLS certificates & keys
src-tauri/certs/*.crt
src-tauri/certs/*.key
src-tauri/certs/*.pem
src-tauri/certs/production.crt

# Archived Historical Documentation
docs/archive/
docs/archive/*

# Release build bundles (large binaries) — never tracked
# Payloads are staged under release-artifacts/iyou_home_<VERSION>/ (outside
# dist/, which Vite's emptyOutDir wipes). The whole versioned payload tree is
# ignored; only the legacy flat manifests (SHA256SUMS*.txt) stay tracked.
release-artifacts/*
release-artifacts/iyou_home_*/
release-artifacts/*.exe
!release-artifacts/*.txt
